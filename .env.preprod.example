# Copier vers un fichier hors Git et remplacer toutes les valeurs replace-*.
COMPOSE_PROJECT_NAME=mse-preproduction
PREPROD_POSTGRES_VOLUME=mse_preprod_postgres_data
POSTGRES_DB=motorsports_events
POSTGRES_USER=mse
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://mse:replace-with-url-encoded-password@postgres:5432/motorsports_events
API_HOST_PORT=3001
WEB_HOST_PORT=3000
VITE_API_URL=http://127.0.0.1:3001
ADMIN_AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_SECRET=replace-with-a-distinct-32-character-random-secret
ADMIN_WEB_ORIGIN=http://127.0.0.1:3000
ADMIN_COOKIE_SECURE=true
TRUST_PROXY_CIDRS=127.0.0.1
PROVIDER_MASTER_KEYS={"1":"replace-with-a-base64-encoded-32-byte-key"}
PROVIDER_ACTIVE_KEY_VERSION=1
