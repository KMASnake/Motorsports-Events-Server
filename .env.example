PROJECT_NAME=Motorsports Events
POSTGRES_DB=motorsport
POSTGRES_USER=motorsport
POSTGRES_PASSWORD=change-me-long-database-password
DATABASE_URL=postgresql+psycopg://motorsport:change-me-long-database-password@db:5432/motorsport

ADMIN_API_KEY=change-me-long-admin-key
PUBLIC_API_KEY=change-me-public-api-key

API_DOMAIN=motorsports-events.fr
ACME_EMAIL=admin@example.com
API_BIND_PORT=8088

OCBLACKTOP_ENABLED=true
OCBLACKTOP_BASE_URL=https://api.ocblacktop.com/v1
OCBLACKTOP_API_KEY=
OCBLACKTOP_SPORTS=formula1,formula2,formula3,formula-e,indycar,nascar,moto-gp,moto2,moto3,wec,wrc

THESPORTSDB_ENABLED=true
