{
  "openapi": "3.1.0",
  "info": {"title": "Motorsports Events Preview Read API", "version": "1.1.0-f5.7a", "description": "Canonical additive public contract. Legacy routes and identifiers remain unchanged when Preview is disabled."},
  "servers": [{"url": "/api/v1"}],
  "security": [{"bearerApiKey": []}],
  "paths": {
    "/championships": {"get": {"operationId": "listChampionships", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/PageCursor"}], "responses": {"200": {"$ref": "#/components/responses/ChampionshipCollection"}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/championships/{id}": {"get": {"operationId": "getChampionship", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"$ref": "#/components/responses/ChampionshipResource"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/events": {"get": {"operationId": "listEvents", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/PageCursor"}, {"name": "championship", "in": "query", "schema": {"type": "string", "maxLength": 120}}, {"name": "championship_id", "in": "query", "description": "Legacy canonical Championship identifier used for entitlement and compatibility filtering.", "schema": {"type": "string", "pattern": "^[A-Za-z0-9]+(?:[._:-][A-Za-z0-9]+)*$", "maxLength": 160}}, {"name": "from", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "to", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "status", "in": "query", "schema": {"$ref": "#/components/schemas/CanonicalEventStatus"}}, {"name": "session_type", "in": "query", "schema": {"type": "string", "maxLength": 64}}], "responses": {"200": {"$ref": "#/components/responses/EventCollection"}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/events/{id}": {"get": {"operationId": "getEvent", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"$ref": "#/components/responses/EventResource"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/meetings": {"get": {"operationId": "listMeetings", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/PageCursor"}], "responses": {"200": {"$ref": "#/components/responses/MeetingCollection"}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/meetings/{id}": {"get": {"operationId": "getMeeting", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"$ref": "#/components/responses/MeetingResource"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/changes": {"get": {"operationId": "listChanges", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}}, {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 2048}}, {"name": "include", "in": "query", "schema": {"enum": ["data"]}}], "responses": {"200": {"$ref": "#/components/responses/Collection"}, "400": {"$ref": "#/components/responses/Error"}, "410": {"description": "sync_cursor_expired", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}, "500": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "securitySchemes": {"bearerApiKey": {"type": "http", "scheme": "bearer", "description": "One-time-issued mse_live_ or mse_test_ client API key"}},
    "parameters": {"Id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}, "PageCursor": {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 2048}}},
    "schemas": {"CanonicalEventStatus": {"type": "string", "enum": ["scheduled", "confirmed", "postponed", "cancelled", "completed"]}, "CanonicalIdentity": {"type": "string", "format": "uuid", "description": "Stable Motorsports-Events canonical identity; never a provider identifier."}, "ChampionshipIdentity": {"type": "object", "additionalProperties": false, "required": ["id", "legacy_id"], "properties": {"id": {"$ref": "#/components/schemas/CanonicalIdentity"}, "legacy_id": {"type": "string", "description": "Existing canonical text identity retained for backward compatibility."}}}, "Championship": {"type": "object", "additionalProperties": false, "required": ["id", "legacy_id", "revision", "name", "last_updated_at"], "properties": {"id": {"$ref": "#/components/schemas/CanonicalIdentity"}, "legacy_id": {"type": "string"}, "revision": {"type": "integer", "minimum": 1}, "name": {"type": ["string", "null"]}, "discipline": {"type": ["object", "null"]}, "last_updated_at": {"type": "string", "format": "date-time"}}}, "ChampionshipSeason": {"type": "object", "additionalProperties": false, "required": ["id", "championship_id", "key", "label"], "properties": {"id": {"$ref": "#/components/schemas/CanonicalIdentity"}, "championship_id": {"$ref": "#/components/schemas/CanonicalIdentity"}, "key": {"type": "string"}, "label": {"type": "string"}}}, "Venue": {"type": "object", "additionalProperties": false, "required": ["id", "key", "name", "kind_key"], "properties": {"id": {"$ref": "#/components/schemas/CanonicalIdentity"}, "key": {"type": "string"}, "name": {"type": "string"}, "kind_key": {"type": "string"}, "timezone": {"type": ["string", "null"]}}}, "VenueLayout": {"type": "object", "additionalProperties": false, "required": ["id", "venue_id", "key", "name"], "properties": {"id": {"$ref": "#/components/schemas/CanonicalIdentity"}, "venue_id": {"$ref": "#/components/schemas/CanonicalIdentity"}, "key": {"type": "string"}, "name": {"type": "string"}}}, "CanonicalMeeting": {"type": "object", "required": ["id", "championship", "championship_season_id", "venue_id", "venue_layout_id", "starts_at", "ends_at", "timezone"], "properties": {"id": {"$ref": "#/components/schemas/CanonicalIdentity"}, "championship": {"type": "object", "required": ["id", "canonical_id"], "properties": {"id": {"type": "string"}, "canonical_id": {"$ref": "#/components/schemas/CanonicalIdentity"}}}, "championship_season_id": {"oneOf": [{"$ref": "#/components/schemas/CanonicalIdentity"}, {"type": "null"}]}, "venue_id": {"oneOf": [{"$ref": "#/components/schemas/CanonicalIdentity"}, {"type": "null"}]}, "venue_layout_id": {"oneOf": [{"$ref": "#/components/schemas/CanonicalIdentity"}, {"type": "null"}]}, "starts_at": {"type": ["string", "null"], "format": "date-time"}, "ends_at": {"type": ["string", "null"], "format": "date-time"}, "timezone": {"type": "string"}}}, "CanonicalEvent": {"type": "object", "required": ["id", "championship", "championship_season_id", "meeting_id", "venue_id", "venue_layout_id", "session", "status", "starts_at", "ends_at", "timezone"], "properties": {"id": {"$ref": "#/components/schemas/CanonicalIdentity"}, "championship": {"type": "object", "required": ["id", "canonical_id"], "properties": {"id": {"type": "string"}, "canonical_id": {"$ref": "#/components/schemas/CanonicalIdentity"}}}, "championship_season_id": {"oneOf": [{"$ref": "#/components/schemas/CanonicalIdentity"}, {"type": "null"}]}, "meeting_id": {"oneOf": [{"$ref": "#/components/schemas/CanonicalIdentity"}, {"type": "null"}]}, "venue_id": {"oneOf": [{"$ref": "#/components/schemas/CanonicalIdentity"}, {"type": "null"}]}, "venue_layout_id": {"oneOf": [{"$ref": "#/components/schemas/CanonicalIdentity"}, {"type": "null"}]}, "session": {"type": "object", "required": ["type_key", "title"], "properties": {"type_key": {"type": "string"}, "title": {"type": ["string", "null"]}}}, "status": {"$ref": "#/components/schemas/CanonicalEventStatus"}, "starts_at": {"type": ["string", "null"], "format": "date-time"}, "ends_at": {"type": ["string", "null"], "format": "date-time"}, "timezone": {"type": "string"}}}, "SessionType": {"type": "object", "additionalProperties": false, "required": ["key", "label", "sort_order", "active"], "properties": {"key": {"type": "string"}, "label": {"type": "string"}, "sort_order": {"type": "integer"}, "active": {"type": "boolean"}}}, "ErrorEnvelope": {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "request_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string"}}}}}, "Collection": {"type": "object", "required": ["data", "pagination"], "properties": {"data": {"type": "array", "items": {"type": "object"}}, "pagination": {"type": "object", "required": ["next_cursor", "has_more"], "properties": {"next_cursor": {"type": ["string", "null"]}, "has_more": {"type": "boolean"}, "sync_cursor": {"type": "string"}}}}}},
    "responses": {"Collection": {"description": "Bounded change cursor page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Collection"}}}}, "ChampionshipCollection": {"description": "Bounded Championship cursor page", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/Collection"}, {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Championship"}}}}]}}}}, "MeetingCollection": {"description": "Bounded Meeting cursor page", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/Collection"}, {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/CanonicalMeeting"}}}}]}}}}, "EventCollection": {"description": "Bounded Event cursor page", "content": {"application/json": {"schema": {"allOf": [{"$ref": "#/components/schemas/Collection"}, {"type": "object", "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/CanonicalEvent"}}}}]}}}}, "ChampionshipResource": {"description": "Canonical Championship representation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Championship"}}}}, "MeetingResource": {"description": "Canonical Meeting representation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanonicalMeeting"}}}}, "EventResource": {"description": "Canonical Event representation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CanonicalEvent"}}}}, "Error": {"description": "Safe structured error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}}
  }
}
