API_HOST_PORT=3001
WEB_HOST_PORT=3000
POSTGRES_DB=motorsports_events
POSTGRES_USER=mse
POSTGRES_PORT=5433
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://mse:change-me@postgres:5432/motorsports_events
API_PORT=3001
WEB_PORT=3000
VITE_API_URL=http://localhost:3001
NODE_ENV=development
ADMIN_AUTH_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_SECRET=replace-with-a-distinct-32-character-random-secret
ADMIN_WEB_ORIGIN=http://localhost:3000
ADMIN_COOKIE_SECURE=false
# Liste explicite uniquement. Exemple Docker/reverse proxy à adapter au réseau réel :
# TRUST_PROXY_CIDRS=127.0.0.1,172.16.0.0/12
TRUST_PROXY_CIDRS=
# JSON version -> clé AES-256 encodée en base64. Valeur illustrative non fonctionnelle.
PROVIDER_MASTER_KEYS={"1":"replace-with-a-base64-encoded-32-byte-key"}
PROVIDER_ACTIVE_KEY_VERSION=1
# Gate 5.7-P-E remains disabled unless explicitly enabled in a private Preview environment.
PREVIEW_API_ENABLED=false
PREVIEW_CURSOR_SECRET=replace-with-at-least-32-random-characters
PREVIEW_API_KEY_PEPPER=replace-with-an-independent-32-character-secret
