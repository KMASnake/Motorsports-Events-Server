{
  "openapi": "3.1.0",
  "info": {"title": "Motorsports Events Preview Read API", "version": "1.0.0-e"},
  "servers": [{"url": "/api/v1"}],
  "security": [{"bearerApiKey": []}],
  "paths": {
    "/championships": {"get": {"operationId": "listChampionships", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/PageCursor"}], "responses": {"200": {"$ref": "#/components/responses/Collection"}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/championships/{id}": {"get": {"operationId": "getChampionship", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"$ref": "#/components/responses/Resource"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/events": {"get": {"operationId": "listEvents", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/PageCursor"}, {"name": "championship", "in": "query", "schema": {"type": "string", "maxLength": 120}}, {"name": "championship_id", "in": "query", "schema": {"type": "string", "format": "uuid"}}, {"name": "from", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "to", "in": "query", "schema": {"type": "string", "format": "date-time"}}, {"name": "status", "in": "query", "schema": {"enum": ["scheduled", "completed", "cancelled", "postponed"]}}, {"name": "session_type", "in": "query", "schema": {"type": "string", "maxLength": 64}}], "responses": {"200": {"$ref": "#/components/responses/Collection"}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/events/{id}": {"get": {"operationId": "getEvent", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"$ref": "#/components/responses/Resource"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/meetings": {"get": {"operationId": "listMeetings", "parameters": [{"$ref": "#/components/parameters/Limit"}, {"$ref": "#/components/parameters/PageCursor"}], "responses": {"200": {"$ref": "#/components/responses/Collection"}, "400": {"$ref": "#/components/responses/Error"}}}},
    "/meetings/{id}": {"get": {"operationId": "getMeeting", "parameters": [{"$ref": "#/components/parameters/Id"}], "responses": {"200": {"$ref": "#/components/responses/Resource"}, "400": {"$ref": "#/components/responses/Error"}, "404": {"$ref": "#/components/responses/Error"}}}},
    "/changes": {"get": {"operationId": "listChanges", "parameters": [{"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 500, "default": 100}}, {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 2048}}, {"name": "include", "in": "query", "schema": {"enum": ["data"]}}], "responses": {"200": {"$ref": "#/components/responses/Collection"}, "400": {"$ref": "#/components/responses/Error"}, "410": {"description": "sync_cursor_expired", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}, "500": {"$ref": "#/components/responses/Error"}}}}
  },
  "components": {
    "securitySchemes": {"bearerApiKey": {"type": "http", "scheme": "bearer", "description": "One-time-issued mse_live_ or mse_test_ client API key"}},
    "parameters": {"Id": {"name": "id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}, "Limit": {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}, "PageCursor": {"name": "cursor", "in": "query", "schema": {"type": "string", "maxLength": 2048}}},
    "schemas": {"ErrorEnvelope": {"type": "object", "additionalProperties": false, "required": ["error"], "properties": {"error": {"type": "object", "additionalProperties": false, "required": ["code", "message", "request_id"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "request_id": {"type": "string"}}}}}, "Collection": {"type": "object", "required": ["data", "pagination"], "properties": {"data": {"type": "array", "items": {"type": "object"}}, "pagination": {"type": "object", "required": ["next_cursor", "has_more"], "properties": {"next_cursor": {"type": ["string", "null"]}, "has_more": {"type": "boolean"}, "sync_cursor": {"type": "string"}}}}}},
    "responses": {"Collection": {"description": "Bounded cursor page", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Collection"}}}}, "Resource": {"description": "Explicit public representation", "content": {"application/json": {"schema": {"type": "object"}}}}, "Error": {"description": "Safe structured error", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ErrorEnvelope"}}}}}
  }
}
