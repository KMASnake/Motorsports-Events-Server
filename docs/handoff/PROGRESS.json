  "lot_5_6_approved_concepts": {
    "current": "Acquire all future provider data from today until provider future exhaustion; J+30 is only the configurable hot window",
    "finalization": "30-day default configurable finalization period with anomaly if provider still does not identify event as finished",
    "recent_catchup": "Past portion of current season during initial bootstrap only",
    "deep_history": "Previous seasons until provider exhaustion; five consecutive valid empty seasons by default",
    "priority": "finalization approximately current-hot > current-future > recent_catchup > deep_history while preserving 5.4 fairness",
    "source_storage": "Durable structured replayable source representation without full-version duplication",
    "identity": "provider_instance_id + championship_source_id + entity_kind + external_id, with explicit synthetic source key fallback",
    "absence": "Only after complete provider traversal and always non-destructive in 5.6",
    "checkpoint": "Advance only after durable successful unit persistence; invalid cursor restarts smallest safe unit",
    "pre_1970": "No positive Unix timestamp assumption or zero-date sentinel",
    "manual_overrides": "Provider acquisition updates source but never destroys active local override",
    "security": "ADR-0016 outbound HTTPS allowlist, redirects, timeout, bounded streaming and redaction apply without exception",
    "boundary_5_7": "Source graph is technical only; no final business normalization, merging or Event-to-Sessions model is introduced in 5.6"
